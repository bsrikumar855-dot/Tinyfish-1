{
  "name": "nptel-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns the NPTEL course catalogue into typed agent tools, powered by TinyFish Agent and Fetch",
  "type": "module",
  "bin": {
    "nptel-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
